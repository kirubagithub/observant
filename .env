# Copy this file to .env and fill in your ClickHouse Cloud service details.
# ---- ClickHouse Cloud ----
CLICKHOUSE_HOST=otp7qe0yz6.ap-south-1.aws.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=c4L3S4e~ipWq_
CLICKHOUSE_DATABASE=inmobi
CLICKHOUSE_SECURE=true
# Two tables, selectable in the sidebar as "Daily" / "Hourly". Neither name is
# ever shown in the UI.
CLICKHOUSE_TABLE_DAILY=ad_events_daily_agg
CLICKHOUSE_DAILY_TIME_COL=date
 
# CLICKHOUSE_HOURLY_TIME_COL is a GUESS ("hour"). Confirm the real column name
# and type in your hourly table before switching the app to Hourly, or every
# query will fail with an "Unknown identifier" error — same failure mode as
# the earlier decomposition bug, different column.
CLICKHOUSE_TABLE_HOURLY=ad_events_hourly_agg
CLICKHOUSE_HOURLY_TIME_COL=hour

# --- LLM report generation (Groq) -------------------------------------------
# Free tier, no credit card: https://console.groq.com
# Leave GROQ_API_KEY empty to run with the deterministic placeholder report.
#GROQ_API_KEY=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
# Check the live model list in your console before changing this.
GROQ_MODEL=
 
# --- Tracing (Langfuse) ------------------------------------------------------
# All three must be set for tracing to switch on. If any is missing the app
# still works, just untraced.
LANGFUSE_SECRET_KEY="sk-lf-ed2c1234-61fc-40f5-b146-ae56717842c1"
LANGFUSE_PUBLIC_KEY="pk-lf-e0141570-682f-401f-873a-76685f4a7644"
LANGFUSE_BASE_URL="https://us.cloud.langfuse.com"

# Set true to enable the SDK's verbose logging when the sidebar reason is not specific enough
LANGFUSE_DEBUG=

# --- Incident annotations ---------------------------------------------------
# SQLite file for "acknowledge this incident" status/notes. Survives page
# refreshes and process restarts, but NOT a container rebuild unless this path
# is on a mounted volume.
#
# Running locally (`streamlit run app.py`): leave this as-is, it lands next
# to the app.
#
# Running via Docker Compose: use /app/data/annotations.db instead (matches
# the volume already mounted in docker-compose.yml) — AND make sure the
# container was recreated (`docker compose up --build`, not just restarted)
# after that volume was added, or the mount point won't exist yet.
ANNOTATIONS_DB_PATH=annotations.db